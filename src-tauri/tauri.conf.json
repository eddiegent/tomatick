{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tomatick",
  "version": "0.1.0",
  "identifier": "io.github.eddiegent.tomatick",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tomatick",
        "width": 200,
        "height": 200,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Eddie Gent",
    "copyright": "Copyright (c) 2026 Eddie Gent",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Productivity",
    "shortDescription": "Pomodoro timer with an always-on-top tomato widget",
    "longDescription": "Tomatick is a free, open source Pomodoro timer. A small always-on-top tomato shows the countdown, with customizable cycles, a countdown mode, break exercises, configurable alerts and local statistics.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
